# Supported adapter: openai_compatible (local or hosted /chat/completions endpoint)
# Leave blank to keep model-backed chat disabled.
CODEXMODEL_PROVIDER=
# Example local endpoint: http://127.0.0.1:1234/v1
CODEXMODEL_BASE_URL=
CODEXMODEL_MODEL=
# Optional for local providers; keep hosted-provider keys private.
CODEXMODEL_API_KEY=
CODEXMODEL_TIMEOUT_SECONDS=30

# Development only: bind to localhost. Add authentication and TLS before deployment.
CODEXMODEL_HOST=127.0.0.1
CODEXMODEL_PORT=8000
